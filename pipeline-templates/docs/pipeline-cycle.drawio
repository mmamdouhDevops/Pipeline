, restart&lt;br&gt;job fails, users keep old version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="740" width="300" height="75" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Smoke&lt;/b&gt; via public URL&lt;br&gt;https://api…/health-status → 2xx&lt;br&gt;(Nginx + TLS + DNS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="120" width="270" height="75" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Contract smoke&lt;/b&gt; (integration-api)&lt;br&gt;OpenAPI paths + /health/ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="225" width="270" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;DAST&lt;/b&gt; – OWASP ZAP API scan&lt;br&gt;(test stage only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="315" width="270" height="60" as="geometry"/></mxCell><mxCell id="c27" value="Optional (suggested):&lt;br&gt;API tests · E2E · performance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1070" y="405" width="270" height="60" as="geometry"/></mxCell><mxCell id="c28" value="All checks&lt;br&gt;passed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="c29" value="Promote &lt;b&gt;same package&lt;/b&gt;&lt;br&gt;to next stage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x=
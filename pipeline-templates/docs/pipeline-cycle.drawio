nt="1"><mxGeometry x="1455" y="760" width="220" height="22" as="geometry"/></mxCell><mxCell id="c38" value="CI step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1455" y="787" width="220" height="22" as="geometry"/></mxCell><mxCell id="c39" value="Security scan (SAST/DAST)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1455" y="814" width="220" height="22" as="geometry"/></mxCell><mxCell id="c40" value="Build / test / verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1455" y="841" width="220" height="22" as="geometry"/></mxCell><mxCell id="c41" value="Approval / decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1455" y="868" width="220" height="22" as="geometry"/></mxCell><mxCell id="c42" value="Deploy step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1455" y="895" width="220" height="22" as="geometry"/></mxCell><mxCell id="c43" value="Database task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1455" y="922" width="220" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 · CI component: SAST (PR) + Build (manual)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;CI component – two stages&lt;/b&gt; · stage 1 &lt;b&gt;CI SAST&lt;/b&gt; runs on every pull request · stage 2 &lt;b&gt;Build&lt;/b&gt; is started manually for a release/hotfix branch" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1600" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Stage 1 · CI SAST – automatic on every pull request (feature/* → develop, fixes → release/*, release/hotfix → main)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1700" height="430" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;feature/add-comments&lt;br&gt;→ develop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="160" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Plan&lt;/b&gt;&lt;br&gt;changed components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="250" width="140" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Policy&lt;/b&gt;&lt;br&gt;Git Flow · names&lt;br&gt;title · CODEOWNERS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="245" width="150" height="80" as="geometry"/></mxCell><mxCell id="c7" value="SAST (parallel)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fdf3f3;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565" y="110" width="250" height="370"
<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" version="24.7.0"><diagram id="page1" name="1 · Overview &amp; Git Flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b&gt;CI/CD cycle – overview (Git Flow)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;CI on every pull request · CD only from release/* and hotfix/* · build once, deploy the same package to every stage&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1200" height="50" as="geometry"/></mxCell><mxCell id="c3" value="main" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#999999;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1650" height="100" as="geometry"/></mxCell><mxCell id="c4" value="hotfix/X.Y.Z" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#999999;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="1650" height="100" as="geometry"/></mxCell><mxCell id="c5" value="release/X.Y.Z" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#999999;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1650" height="100" as="geometry"/></mxCell><mxCell id="c6" value="develop" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#999999;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1650" height="100" as="geometry"/></mxCell><mxCell id="c7" value="feature/*" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#999999;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1650" height="100" as="geometry"/></mxCell><mxCell id="c8" value="Developer creates&lt;br&gt;&lt;b&gt;feature/add-comments&lt;/b&gt; from develop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="200" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Pull request → develop&lt;/b&gt;&lt;br&gt;CI runs on every push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="590" width="190" height="60" as="geometry"/></mxCell><mxCell id="c10" value="CI / Summary green&lt;br&gt;+ 2 approvals?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="465" width="170" height="70" as="geometry"/></mxCell><mxCell id="c11" value="Merged into &lt;b&gt;develop&lt;/b&gt;&lt;br&gt;(no deployment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="170" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Release manager creates&lt;br&gt;&lt;b&gt;release/1.0.0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="350" width="170" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Build&lt;/b&gt; (manual) → artifacts&lt;br&gt;&lt;b&gt;CD&lt;/b&gt; (manual) TEST → STAGING&lt;br&gt;(→ PRODUCTION later)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="345" width="220" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Fix found? PR &lt;b&gt;fix/*&lt;/b&gt; → release/1.0.0&lt;br&gt;(CI + 2 approvals) → Run Build again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="440" width="220" height="50" as="geometry"/></mxCell><mxCell id="c15" value="After production / hand-off:&lt;br&gt;PR &lt;b&gt;release → main&lt;/b&gt;&lt;br&gt;PR &lt;b&gt;release → develop&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="345" width="190" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;main&lt;/b&gt;&lt;br&gt;tag v1.0.0 + GitHub Release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="105" width="150" height="70" as="geometry"/></mxCell><mxCell id="c17" value="develop updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="470" width="150" height="50" as="geometry"/></mxCell><mxCell id="c18" value="Hotfix from main&lt;br&gt;&lt;b&gt;hotfix/1.0.1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="225" width="170" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Build&lt;/b&gt; → &lt;b&gt;CD&lt;/b&gt; (manual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="225" width="220" height="60" as="geometry"/></mxCell><mxCell id="c20" value="PR &lt;b&gt;hotfix → main&lt;/b&gt;&lt;br&gt;PR &lt;b&gt;hotfix → develop&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="225" width="190" height="60" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="no → fix &amp; push&lt;br&gt;(approvals reset)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="680"/><mxPoint x="425" y="680"/></Array></mxGeometry></mxCell><mxCell id="c25" value="cut release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Run Build, Run CD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1500" y="380"/><mxPoint x="1500" y="161"/></Array></mxGeometry></mxCell><mxCell id="c30" value="merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;dashed=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1385" y="495"/></Array></mxGeometry></mxCell><mxCell id="c31" value="urgent bug" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" 